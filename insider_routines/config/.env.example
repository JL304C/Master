# Insider Routines — environment configuration.
#
# Copy this file to insider_routines/.env (one folder up) and fill it in.
# .env is git-ignored — never commit it.

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Anthropic API key (Frank uses Claude to read Fed speeches).
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gmail SMTP — the address Ross sends from + an app password (NOT your
# regular Gmail password; needs 2-Step Verification). Create one at:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional — where Ross sends to. Defaults to GMAIL_USER (sends to self).
GMAIL_TO=

# SEC requires every request to identify a person: "Your Name you@email.com".
# Defaults to "InsiderRoutines <GMAIL_USER>" if left blank.
SEC_USER_AGENT=

# ── RECOMMENDED ──────────────────────────────────────────────────────────────

# Maya (whale-watcher) skips without this. Free key: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Telegram delivery. Leave blank to disable.
# Create a bot via @BotFather, get the token. Get your chat ID by messaging
# the bot then visiting: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Maggie maps CUSIPs to tickers with OpenFIGI. Works without a key (slower).
# Free key: https://www.openfigi.com/api
OPENFIGI_API_KEY=

# ── ADVANCED (defaults are sensible) ─────────────────────────────────────────

# Model + effort Frank uses.
# INSIDER_MODEL=claude-opus-5-5
# INSIDER_EFFORT=medium

# Sophie: fire when >= 3 scouts agree within 7 days.
# SOPHIE_MIN_AGREE=3
# SOPHIE_WINDOW_DAYS=7

# Max signals per run for the stock scouts.
# EDDIE_MAX_SIGNALS=10
# MAGGIE_MAX_SIGNALS=10
