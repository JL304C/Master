ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
# Leave "no" until you approve BACKTEST_REPORT.md. "no" = dry run, nothing is submitted.
LADDER_BACKTEST_APPROVED=no
# Max % of account equity this strategy may tie up (cash-secured basis)
LADDER_BP_CAP_PCT=20
# hold = backtested baseline (hold to expiry); stop = also close below breakeven
LADDER_MODE=hold
